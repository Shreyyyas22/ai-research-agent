GROQ_API_KEY=
POSTGRES_USER=research_agent
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=research_agent
DATABASE_URL=postgresql://research_agent:replace-with-a-local-development-password@localhost:5433/research_agent
REDIS_URL=redis://localhost:6379/0
WORKER_POLL_INTERVAL_SECONDS=1
API_PORT=8000
MAX_LLM_CALLS=50
MAX_TOOL_CALLS=10
MAX_RESEARCH_TIME=120
MAX_AGENT_ITERATIONS=2
MAX_CONTEXT_SIZE=8192
LLM_PROVIDER=groq


# Tavily web search (optional until real search is enabled)
TAVILY_API_KEY=

# Gemini (alternative to Groq)
GEMINI_API_KEY=
